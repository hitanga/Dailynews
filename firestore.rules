rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Blogs collection
    match /blogs/{blogId} {
      // Allow read and write for visitors and editorial staff
      allow read, write: if true;
    }

    // Inquiries collection for contact form submissions
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
  }
}
